{
  "name": "obsidian-duet",
  "version": "0.4.0",
  "description": "Work with Claude Code or Codex in your Obsidian notes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin",
    "lint": "npm install --prefix scripts/lint --no-audit --no-fund --silent && npm run --prefix scripts/lint lint",
    "test": "vitest run test/unit",
    "plugin:build": "node scripts/plugin.mjs",
    "plugin:dev": "node scripts/dev-vault.mjs && node scripts/plugin.mjs --vault dev-vault --watch",
    "test:obsidian": "vitest run test/obsidian",
    "screenshots": "tsx scripts/screenshots/capture.ts",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "yami": "file:../yami/yami",
    "yami-obsidian": "file:../yami/yami-obsidian"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yjs": "^13.6.33"
  }
}
