{
  "private": true,
  "description": "Obsidian's review rules for the plugin. typescript-eslint needs the TypeScript 5 API, which TypeScript 7 does not have, so the linter has its own install.",
  "type": "module",
  "scripts": {
    "lint": "cd ../.. && eslint --config scripts/lint/eslint.config.mjs --max-warnings 0 plugin/src package.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1"
  }
}
